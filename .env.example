# Copy this file to .env and fill in what you want. Everything is OPTIONAL: the system also runs without any of it.
# Never commit your real .env (it is in .gitignore).

# AI-written notes and summaries (free key from Google AI Studio). Without it, standard texts are used.
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Real e-mails (Gmail: use an "App password", never your normal password). Without these, reports go to the outbox/ folder.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
OPS_HEAD_EMAIL=
WH_MANAGER_EMAIL=

# Links between the apps (change them when the apps run on other addresses)
STORE_APP_URL=http://localhost:8502
PACKING_APP_URL=http://localhost:8503
STOCK_REQUEST_APP_URL=http://localhost:8504

# Name given to products that have no vendor in the data
PLACEHOLDER_VENDOR=UNASSIGNED VENDOR
